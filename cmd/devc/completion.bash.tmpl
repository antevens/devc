# shellcheck shell=bash
#
# bash completion for devc, load with: source <(devc completion bash)

#######################################
# Complete devc arguments for bash programmable completion.
# Globals:
#   COMP_WORDS
#   COMP_CWORD
#   COMPREPLY
#######################################
function _devc_complete() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=()
  if [[ "${COMP_CWORD}" -eq 1 ]]; then
    mapfile -t COMPREPLY < <(compgen -W "{{.}} --help --version" -- "${cur}")
  elif [[ "${COMP_WORDS[1]}" == "rm" ]]; then
    local names
    names="$(docker ps --all --filter label=devcontainer.local_folder \
      --format '{{"{{.Names}}"}}' 2>/dev/null)"
    mapfile -t COMPREPLY < <(compgen -W "${names} -y --yes" -- "${cur}")
  elif [[ "${COMP_CWORD}" -eq 2 ]]; then
    case "${COMP_WORDS[1]}" in
      shell)
        mapfile -t COMPREPLY < <(compgen -c -- "${cur}")
        ;;
      completion)
        mapfile -t COMPREPLY < <(compgen -W "bash" -- "${cur}")
        ;;
      *) ;;
    esac
  fi
}

complete -F _devc_complete devc
